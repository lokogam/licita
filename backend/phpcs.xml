<?xml version="1.0"?>
<ruleset name="Tenders API">
    <description>PSR-12 coding standard.</description>

    <file>app</file>
    <file>public/index.php</file>
    <file>tests</file>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- Small test doubles live next to the test that uses them. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Test method names use snake_case for readability (test_it_does_something). -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
