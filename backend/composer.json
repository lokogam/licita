{
    "name": "duvangamboa/suplos-tenders-api",
    "description": "Tenders module REST API built with plain PHP (MVC) and standalone Eloquent.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-bcmath": "*",
        "ext-fileinfo": "*",
        "ext-pdo": "*",
        "illuminate/database": "^11.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:feature": "phpunit --testsuite Feature",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    },
    "config": {
        "platform": {
            "php": "8.2.30"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
