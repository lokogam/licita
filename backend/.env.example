# Used only when running the API outside Docker (php -S, local PHPUnit).
APP_ENV=local
APP_KEY=change-me-to-a-long-random-string
APP_DEBUG=true
APP_URL=http://localhost:8080
CORS_ALLOWED_ORIGIN=*

# Authentication: access token lifetime (seconds) and refresh token lifetime (days).
JWT_TTL=900
REFRESH_TTL_DAYS=7
# Send the refresh cookie only over HTTPS (keep true in production).
COOKIE_SECURE=false
# Read the client IP from X-Forwarded-For (only behind a trusted proxy, e.g. Render).
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=licita
DB_USERNAME=licita
DB_PASSWORD=secret
