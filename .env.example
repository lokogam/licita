# Docker Compose variables (copy to .env and adjust if needed)
APP_ENV=production
APP_KEY=change-me-to-a-long-random-string
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
WEB_PORT=5173
API_PORT=8081

DB_DATABASE=licita
DB_USERNAME=licita
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
DB_FORWARD_PORT=3307

# Antivirus (docker compose --profile antivirus)
CLAMAV_ENABLED=false
